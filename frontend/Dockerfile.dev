FROM node:20-alpine

WORKDIR /app

# Сначала копируем только файлы зависимостей для кэширования
COPY package*.json ./
RUN npm install

# Копируем остальной код (он будет перезаписан volume'ом при запуске)
COPY . .

# Vite по умолчанию слушает только localhost, нужно открыть его для Docker
EXPOSE 5173

# Запускаем Vite с флагом --host, чтобы он был доступен снаружи контейнера
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]